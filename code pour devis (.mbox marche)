# 5. GÉNÉRATION DE LA FEUILLE EXCEL STYLISÉE
# ===============================================================

def generer_excel_style(candidats, fichier_sortie):
    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Rapport Devis"
    ws.views.sheetView[0].showGridLines = True

    # Palette de couleurs
    BLEU_NUIT = "1B2A4A"
    VERT_FOND = "E8F5E9"
    VERT_TEXTE = "2E7D32"
    ORANGE_FOND = "FFF3E0"
    ORANGE_TEXTE = "E65100"
    ROUGE_FOND = "FFEBEE"
    ROUGE_TEXTE = "C62828"
    GRIS_TEXTE = "555555"

    border_thin = Border(bottom=Side(style="thin", color="E0E0E0"))

    # 1. En-tête bleu nuit (A1:B2 pour le titre, C1:D2 pour les métadonnées)
    ws.merge_cells("A1:B2")
    ws["A1"] = "LA LISTE DES MORTS"
    ws["A1"].font = Font(name="Segoe UI", size=18, bold=True, color="FFFFFF")
    ws["A1"].alignment = Alignment(vertical="center", indent=1)

    ws.merge_cells("A3:B3")
    ws["A3"] = "Devis envoyés jamais relancés — rapport de scan"
    ws["A3"].font = Font(name="Segoe UI", size=10, italic=True, color="D0D8E8")
    ws["A3"].alignment = Alignment(vertical="top", indent=1)

    # Appliquer le fond bleu sur tout le bloc A1:D3
    for row in ws["A1:D3"]:
        for cell in row:
            cell.fill = PatternFill(start_color=BLEU_NUIT, fill_type="solid")

    # Champs en haut à droite
    ws["C1"] = "NOM DU CLIENT :"
    ws["C1"].font = Font(name="Segoe UI", size=9, bold=True, color="A0B0D0")
    ws["C1"].alignment = Alignment(horizontal="right", vertical="center")
    
    ws["C2"] = "DATE DU SCAN :"
    ws["C2"].font = Font(name="Segoe UI", size=9, bold=True, color="A0B0D0")
    ws["C2"].alignment = Alignment(horizontal="right", vertical="center")

    ws["D2"] = datetime.now().strftime("%d/%m/%Y")
    ws["D2"].font = Font(name="Segoe UI", size=9, color="FFFFFF")
    ws["D2"].alignment = Alignment(horizontal="center", vertical="center")

    # 2. Section du montant total
    ws.merge_cells("A5:D6")
    ws["A5"] = '=SUM(C9:C1000)'
    ws["A5"].number_format = '#,##0 "€"'
    ws["A5"].font = Font(name="Segoe UI", size=32, bold=True, color=BLEU_NUIT)
    ws["A5"].alignment = Alignment(horizontal="center", vertical="center")

    ws.merge_cells("A7:D7")
    ws["A7"] = f"endormis dans votre boîte mail ({len(candidats)} devis identifiés)"
    ws["A7"].font = Font(name="Segoe UI", size=11, bold=True, color=GRIS_TEXTE)
    ws["A7"].alignment = Alignment(horizontal="center", vertical="top")

    # 3. Répartition des candidats
    verts = [c for c in candidats if c["score_brut"] >= 5]
    oranges = [c for c in candidats if c["score_brut"] in (3, 4)]
    rouges = [c for c in candidats if c["score_brut"] < 3]

    row_idx = 9

    def inserer_categorie(titre, fond, texte_color, liste_items):
        nonlocal row_idx
        ws.merge_cells(start_row=row_idx, start_column=1, end_row=row_idx, end_column=4)
        cell = ws.cell(row=row_idx, column=1, value=titre)
        cell.font = Font(name="Segoe UI", size=10, bold=True, color=texte_color)
        cell.fill = PatternFill(start_color=fond, fill_type="solid")
        cell.alignment = Alignment(indent=1, vertical="center")
        ws.row_dimensions[row_idx].height = 24
        row_idx += 1

        for item in liste_items:
            c1 = ws.cell(row=row_idx, column=1, value=item["expediteur"])
            c1.font = Font(name="Segoe UI", size=10, color="333333")
            c1.border = border_thin

            c2 = ws.cell(row=row_idx, column=2, value=item["objet"])
            c2.font = Font(name="Segoe UI", size=10, color="555555")
            c2.border = border_thin

            c3 = ws.cell(row=row_idx, column=3, value=0)
            c3.font = Font(name="Segoe UI", size=10, bold=True, color="333333")
            c3.number_format = '#,##0 "€"'
            c3.alignment = Alignment(horizontal="right")
            c3.border = border_thin

            c4 = ws.cell(row=row_idx, column=4, value=item["date"])
            c4.font = Font(name="Segoe UI", size=10, color="777777")
            c4.alignment = Alignment(horizontal="center")
            c4.border = border_thin

            ws.row_dimensions[row_idx].height = 20
            row_idx += 1
        
        row_idx += 1

    inserer_categorie(f"🟢 À RELANCER MAINTENANT — {len(verts)} devis", VERT_FOND, VERT_TEXTE, verts)
    inserer_categorie(f"🟡 À RELANCER EN DOUCEUR — {len(oranges)} devis", ORANGE_FOND, ORANGE_TEXTE, oranges)
    inserer_categorie(f"🔴 PROBABLEMENT PERDUS — {len(rouges)} devis", ROUGE_FOND, ROUGE_TEXTE, rouges)

    ws.column_dimensions["A"].width = 28
    ws.column_dimensions["B"].width = 45
    ws.column_dimensions["C"].width = 16
    ws.column_dimensions["D"].width = 16

    wb.save(fichier_sortie)


# ===============================================================
# 6. PROGRAMME PRINCIPAL
# ===============================================================

def main():
    print("=" * 60)
    print("  CHASSE AUX DEVIS FANTOMES — scan universel (mbox + pst)")
    print("=" * 60)

    chemin = CHEMIN
    if not chemin:
        chemin = input("\nGlisse-dépose le fichier/dossier ici, puis Entrée : ")

    # Nettoyage rigoureux du chemin d'accès
    chemin = chemin.strip().strip('"').strip("'").strip("’").strip("& ")
    if chemin.startswith("file:///"):
        chemin = chemin.replace("file:///", "")
    chemin = os.path.normpath(chemin)

    print(f"\n[INFO] Chemin analysé : {chemin}")

    sources = collecter_sources(chemin)
    if not sources:
        print(f"\n[ERREUR] Impossible de trouver le dossier ou fichier : {chemin}")
        print("Vérifie que le chemin existe ou place tes fichiers directement dans le dossier.")
        return

    nb_pst = sum(1 for f, _ in sources if f == "pst")
    pypff_ok = True
    if nb_pst > 0:
        try:
            import pypff  # noqa: F401
        except ImportError:
            pypff_ok = False
            print("\n!! Librairie pypff manquante : les .pst seront ignorés.")

    date_min = datetime.strptime(DEPUIS, "%Y-%m-%d") if DEPUIS else datetime.now() - timedelta(days=30 * FENETRE_MOIS)

    candidats = []

    for fmt, chemin_source in sources:
        if fmt == "pst" and not pypff_ok:
            continue

        try:
            mails = iterer_mbox(chemin_source) if fmt == "mbox" else iterer_pst(chemin_source)
        except Exception as e:
            print(f"  !! Erreur lors de la lecture de {chemin_source} : {e}")
            continue

        for mail in mails:
            if mail["date"] and mail["date"] < date_min:
                continue

            ok, score = score_candidat(mail)
            if not ok:
                continue

            candidats.append({
                "date": mail["date"].strftime("%Y-%m-%d") if mail["date"] else "",
                "source": mail["dossier"][:80],
                "expediteur": extraire_adresses(mail["expediteur"]) or mail["expediteur"][:150],
                "destinataire": extraire_adresses(mail["destinataire"])[:200],
                "objet": mail["objet"][:300],
                "extrait": re.sub(r"\s+", " ", mail["corps"])[:500],
                "piece_jointe": "oui" if mail["jointe"] else "non",
                "score_brut": score,
            })

    candidats.sort(key=lambda c: (c["score_brut"], c["date"]), reverse=True)
    candidats = candidats[:TOP]

    os.makedirs(DOSSIER_SORTIE, exist_ok=True)
    sortie_excel = os.path.join(DOSSIER_SORTIE, FICHIER_EXCEL)

    generer_excel_style(candidats, sortie_excel)

    print("\n" + "=" * 60)
    print("Rapport Excel créé avec succès dans :")
    print(f"  -> {sortie_excel}")
    print("=" * 60)


if __name__ == "__main__":
    main()
