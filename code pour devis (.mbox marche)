# ===============================================================
# 1. COLLECTE DES FICHIERS SELON LE FORMAT
# ===============================================================

def collecter_sources(chemin):
    sources = []

    # Cas 1 : fichier .zip
    if chemin.lower().endswith(".zip") and os.path.isfile(chemin):
        print("Zip détecté : extraction des boîtes dedans...")
        dossier_tmp = tempfile.mkdtemp(prefix="takeout_")
        with zipfile.ZipFile(chemin) as z:
            for nom in z.namelist():
                bas = nom.lower()
                if bas.endswith(".mbox") or bas.endswith(".pst"):
                    cible = os.path.join(dossier_tmp, os.path.basename(nom))
                    with z.open(nom) as src, open(cible, "wb") as dst:
                        dst.write(src.read())
                    fmt = "mbox" if bas.endswith(".mbox") else "pst"
                    sources.append((fmt, cible))
                    print(f"  extrait : {os.path.basename(nom)} ({fmt})")
        return sources

    # Cas 2 : fichier .mbox
    if os.path.isfile(chemin) and chemin.lower().endswith(".mbox"):
        return [("mbox", chemin)]

    # Cas 3 : fichier .pst
    if os.path.isfile(chemin) and chemin.lower().endswith(".pst"):
        return [("pst", chemin)]

    # Cas 4 : dossier
    if os.path.isdir(chemin):
        for racine, _, noms in os.walk(chemin):
            for n in noms:
                bas = n.lower()
                if bas.endswith(".mbox"):
                    sources.append(("mbox", os.path.join(racine, n)))
                elif bas.endswith(".pst"):
                    sources.append(("pst", os.path.join(racine, n)))
        return sources

    return []


# ===============================================================
# 2. LECTEUR MBOX
# ===============================================================

def decoder(valeur):
    if not valeur:
        return ""
    try:
        return str(make_header(decode_header(valeur)))
    except Exception:
        return str(valeur)


def iterer_mbox(chemin_mbox):
    boite = mailbox.mbox(chemin_mbox)
    for message in boite:
        From = message.get("From", "")
        expediteur = ""
        try:
            _, mails = getaddresses([From])
            expediteur = (mails[0][1] or "").lower()
        except Exception:
            expediteur = (From or "").lower()

        corps = ""
        try:
            if message.is_multipart():
                morceaux = []
                for part in message.walk():
                    if part.get_content_type() == "text/plain":
                        charset = part.get_content_charset() or "utf-8"
                        morceaux.append(part.get_payload(decode=True).decode(charset, errors="replace"))
                corps = "\n".join(morceaux)
            else:
                charset = message.get_content_charset() or "utf-8"
                corps = message.get_payload(decode=True).decode(charset, errors="replace")
        except Exception:
            corps = ""

        jointe = False
        try:
            for part in message.walk():
                if part.get_filename():
                    jointe = True
                    break
        except Exception:
            jointe = False

        d = None
        try:
            d = parsedate_to_datetime(message.get("date")).replace(tzinfo=None)
        except Exception:
            d = None

        yield {
            "dossier": os.path.basename(chemin_mbox),
            "date": d,
            "expediteur": expediteur,
            "destinataire": decoder(message.get("To", "")),
            "objet": decoder(message.get("Subject", "")),
            "corps": corps,
            "jointe": jointe,
        }


# ===============================================================
# 3. LECTEUR PST
# ===============================================================

def decode_corps(brut):
    if brut is None:
        return ""
    if isinstance(brut, str):
        return brut
    try:
        if b"\x00" in brut[:200]:
            return brut.decode("utf-16-le", errors="replace")
        return brut.decode("utf-8", errors="replace")
    except Exception:
        try:
            return brut.decode("cp1252", errors="replace")
        except Exception:
            return ""


def chercher_entete(entetes, champ):
    if not entetes:
        return ""
    match = re.search(r"^" + champ + r":\s*(.+)$", entetes, re.MULTILINE | re.IGNORECASE)
    return match.group(1).strip() if match else ""


def iterer_pst(chemin_pst):
    import pypff
    pst = pypff.file()
    pst.open(chemin_pst)
    racine = pst.get_root_folder()
    nom_fichier = os.path.basename(chemin_pst)

    def walk(dossier, chemin_nom):
        nom = dossier.name if dossier.name else ""
        ici = (chemin_nom + "/" + nom).strip("/")
        for i in range(dossier.number_of_sub_folders):
            yield from walk(dossier.get_sub_folder(i), ici)
        for i in range(dossier.number_of_sub_messages):
            yield lire_message_pst(dossier.get_sub_message(i), nom_fichier + "/" + ici)

    yield from walk(racine, "")


def lire_message_pst(message, dossier):
    entetes = message.transport_headers or ""
    expediteur = chercher_entete(entetes, "From") or message.sender_name or ""
    destinataire = chercher_entete(entetes, "To")

    d = None
    try:
        d = message.client_submit_time
        if d:
            d = d.replace(tzinfo=None)
    except Exception:
        d = None
    if d is None:
        try:
            d = parsedate_to_datetime(chercher_entete(entetes, "Date")).replace(tzinfo=None)
        except Exception:
            d = None

    jointe = False
    try:
        jointe = message.number_of_attachments > 0
    except Exception:
        jointe = False

    return {
        "dossier": dossier,
        "date": d,
        "expediteur": expediteur,
        "destinataire": destinataire,
        "objet": message.subject or "",
        "corps": decode_corps(message.plain_text_body),
        "jointe": jointe,
    }


# ===============================================================
# 4. DÉTECTION DES CANDIDATS
# ===============================================================

def score_candidat(mail):
    mail_bas = mail["expediteur"].lower()
    sujet_bas = mail["objet"].lower()
    corps_bas = mail["corps"].lower()
    texte_bas = sujet_bas + " " + corps_bas

    if any(motif in mail_bas for motif in EXPEDITEURS_EXCUS):
        return False, 0
    if any(mot in texte_bas for mot in MOTS_EXCLUS):
        return False, 0

    score = 0
    for mot in MOTS_DEVIS:
        mot_clean = mot.strip().lower()
        if mot_clean in sujet_bas:
            score += 3
        elif mot_clean in corps_bas:
            score += 1

    if mail["jointe"]:
        score += 2

    for mot in MOTS_CLOSING:
        if mot in texte_bas:
            score += 1
            break

    return (score >= 3), score


def extraire_adresses(texte):
    if not texte:
        return ""
    return " ".join(re.findall(r"[\w.+-]+@[\w.-]+\.\w+", texte))


